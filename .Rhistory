data <- data.frame(
ID = c(1, 2, 3, 2, 4, 3, 1, 5),
Value = c(10, 15, 20, 15, 25, 20, 10, 30)
)
data
# Identify duplicate rows and count occurrences
duplicate_counts <- table(data)
# Create a new dataset with unique rows and duplications count
unique_data <- as.data.frame(unique(data))
unique_data$Duplications <- duplicate_counts[match(rownames(unique_data), names(duplicate_counts))]
# Display the new dataset
print(unique_data)
