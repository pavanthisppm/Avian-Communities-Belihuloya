# Sample data
data <- data.frame(
ID = c(1, 2, 3, 2, 4, 3, 1, 5),
Value = c(10, 15, 20, 15, 25, 20, 10, 30)
)
data
# Identify duplicate rows and count occurrences
duplicate_rows <- data[duplicated(data) | duplicated(data, fromLast = TRUE), ]
duplicates_count <- table(duplicate_rows)
# Display duplicate rows and their counts
if (length(duplicates_count) > 0) {
cat("Duplicate rows and their counts:\n")
print(duplicates_count)
} else {
cat("No duplicate rows found.\n")
}
