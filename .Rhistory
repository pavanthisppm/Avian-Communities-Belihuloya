# Hierarchical clustering using the mtcars dataset
data <- mtcars
dist_matrix <- dist(data)
hc <- hclust(dist_matrix)
# Plot the dendrogram
plot(hc, main = "Dendrogram for mtcars Dataset", xlab = "Cars", sub = NULL)
# Add color rectangles to highlight clusters
rect.hclust(hc, k = 3, border = 2:4)
