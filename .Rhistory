geom_text(aes(label = paste(Cloudline,"(",Freq,")")), size = 4, vjust = 2.2) +
scale_size(name = "Size", range = c(5, 12)) +
theme(legend.position = "none")+
labs(x = "Month", y = "Elevation of the cloudline", title = " ") +
geom_line( aes(y = (Max-20)/0.01),   color = "blue", size=0.1, linetype = 4) +
geom_text(aes(y = (Max-20)/0.01, label= Max),   hjust = 0.5, vjust =1.5,  size= 3, color= "blue") +
geom_line( aes(y = (Min-20)/0.01),   color = "red", size=0.1) +
geom_text(aes(y = (Min-20)/0.01, label= Min),   hjust = 0.5, vjust = -0.5,  size= 3, color= "red") +
geom_line( aes(y = (Mean-20)/0.01),   color = "orange", size=0.1) +
geom_text(aes(y = (Mean-20)/0.01, label= Mean),   hjust = 1, vjust = -0.5,  size= 3, color= "orange") +
scale_x_discrete(breaks = 1:8, labels = c("Sep","Oct","Nov", "Dec", "Jan", "Feb", "Mar", "Apr"))+
scale_y_continuous(name = "Cloudline Elevation", limits = c(0, 2000), breaks = seq(0, 2000, by = 500), sec.axis = sec_axis( trans=~.*0.01+20, name="Temperature"))
dev.off()
