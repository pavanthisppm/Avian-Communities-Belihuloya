# Your data frame (replace this with your actual data)
your_data <- data.frame(
species = c("SA", "SB", "SC"),
variable1 = c(1, 2, 3),
variable2 = c(4, 5, 6)
)
# Duplicate rows based on the "species" column
result <- your_data %>%
slice(rep(row_number(), each = 3)) %>%
mutate(species = rep(c("SA", "SB", "SC"), each = nrow(your_data)))
# Print the result
print(result)
