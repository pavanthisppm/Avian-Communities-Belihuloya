library(dendextend)
install.packages("dendextend")
data = PCA_New
sum(is.na(data))
colnames(data)
variables_to_remove <- c("ID", "Sampling_Session")
data <- data %>%
select(-one_of(variables_to_remove))
# Install and load the required package
# install.packages("plotly")
library(plotly)
library(dendextend)
# Example: Interactive dendrogram with plotly
dist_matrix <- dist(data)
hc <- hclust(dist_matrix)
dend <- as.dendrogram(hc)
# Convert dendrogram to a data frame
dend_data <- dend %>% as.dendrogram %>% dendrogram_to_data_frame
# Plot the dendrogram using plot_ly
plot_ly(data = dend_data, type = "scatter", mode = "lines") %>%
layout(title = "Interactive Dendrogram", width = 800, height = 600)
# Extract dendrogram data
dend_data <- dend %>% dendro_data()
