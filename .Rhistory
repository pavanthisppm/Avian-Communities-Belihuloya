# Sample data
months <- c("2022-01-01", "2022-01-02", "2022-01-03", "2022-02-01", "2022-02-02", "2022-02-03")
cloudline <- c(25, 30, 20, 22, 28, 18)
# Convert "Month" to Date format
months <- as.Date(months)
# Create a line plot
plot(months, cloudline, type = "l", xlab = "Month", ylab = "Cloudline", main = "Cloudline Over Time")
# Sample data
months <- c("2022-01-01", "2022-01-02", "2022-01-03", "2022-02-01", "2022-02-02", "2022-02-03")
cloudline <- c(25, 30, 20, 22, 28, 18)
temperature <- c(15, 18, 12, 14, 20, 10)
# Convert "Month" to Date format
months <- as.Date(months)
# Create a bubble plot
plot(months, cloudline, pch = 16, col = temperature, cex = temperature, main = "Bubble Plot",
xlab = "Month", ylab = "Cloudline", xlim = range(months), ylim = range(cloudline))
# Add a color legend
legend("topright", legend = "Temperature", fill = heat.colors(10), title = "Temperature")
library(ggbeeswarm)
install.packages("ggbeeswarm")
library(ggbeeswarm)
ggplot(data, aes(x = Sampling_Session, y = cloudline)) +
geom_beeswarm()
# Sample data
set.seed(1995)
y <- round(rnorm(200), 1)
df <- data.frame(y = y,
group = sample(c("G1", "G2", "G3"),
size = 200,
replace = TRUE))
df
ggplot(df, aes(x = group, y = y)) +
geom_beeswarm()
data
ggplot(data, aes(x = Sampling_Session, y = cloudline)) +
geom_beeswarm()
check_aesthetics()
